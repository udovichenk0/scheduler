[
  {
    "label": "start",
    "command": "make",
    "args": ["dev"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
  {
    "label": "run backend",
    "command": "make",
    "args": ["run-go"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
  {
    "label": "run frontend",
    "command": "make",
    "args": ["frontend"],
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
  },
  {
    "label": "docker: compose up -d",
    "command": "make",
    "args": ["compose"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "hide": "on_success",
  },
  {
    "label": "build backend",
    "command": "make",
    "args": ["build-go"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "migrations",
    "command": "make",
    "args": ["migration"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    // "hide": "on_success",
  },
  {
    "label": "orval",
    "command": "make",
    "args": ["orval"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    // "hide": "on_success",
  },
  {
    "label": "knip",
    "command": "pnpm",
    "args": ["run", "-C", "client", "knip"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
  {
    "label": "clean",
    "command": "make",
    "args": ["clean"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "hide": "on_success",
  },
  {
    "label": "full-clean",
    "command": "make",
    "args": ["full-clean"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "hide": "on_success",
  },

  {
    "label": "rebuild backend → run dev",
    "command": "bash",
    "args": ["-c", "make build-go && make dev"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
  },
]
